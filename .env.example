# Copy to .env (ignored). Set ONE provider and its key. Never commit real keys.
ASR_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Alternative ASR only: ASR_PROVIDER=openai; set OPENAI_API_KEY above.
# Groq defaults to whisper-large-v3; OpenAI defaults to whisper-1 (Whisper v2).
# Optional override; leave unset to use the provider's model default:
# ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=en
ASR_TEMPERATURE=0
ASR_CHUNK_SECONDS=600
ASR_REQUEST_TIMEOUT=300
ASR_TOTAL_TIMEOUT=7200
# If tools are not on PATH, set executable paths (without extra flags):
# FFMPEG_PATH=
# FFPROBE_PATH=

# Phase III: local Community-1; token is only for initial model acquisition.
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_MODEL_REVISION=3533c8cf8e369892e6b79ff1bf80f7b0286a54ee
DIARIZATION_MODEL_CACHE=.models/diarization/community-1
DIARIZATION_DEVICE=cuda
DIARIZATION_OFFLINE_ONLY=true
# Leave speaker counts unset for automatic estimation. Exact count excludes bounds.
# DIARIZATION_NUM_SPEAKERS=2
# DIARIZATION_MIN_SPEAKERS=2
# DIARIZATION_MAX_SPEAKERS=4
DIARIZATION_ALIGNMENT_TOLERANCE_SECONDS=0.1
DIARIZATION_NEAREST_TURN_MAX_GAP_SECONDS=0.2
DIARIZATION_UTTERANCE_MAX_GAP_SECONDS=1
DIARIZATION_MAX_DURATION_SECONDS=28800

# Phase IV: explicit download once; inference always uses pinned local CPU weights.
GROUNDING_MODEL_CACHE=.models/grounding/minilm
GROUNDING_INDEX_CACHE=.cache/grounding
GROUNDING_OFFLINE_ONLY=true
GROUNDING_TOP_K=5
GROUNDING_MIN_SCORE=0.64
GROUNDING_LEXICAL_FLOOR=0.78
GROUNDING_PHONETIC_FLOOR=0.88
GROUNDING_CONTEXT_FLOOR=0.30
GROUNDING_MAX_SPAN_WORDS=4
GROUNDING_CONTEXT_CHARS=600
GROUNDING_NEIGHBOR_GAP_SECONDS=3
GROUNDING_BATCH_SIZE=32
GROUNDING_CPU_THREADS=4
# Phase V conservative terminology refinement (Groq key above is reused).
REFINER_PROVIDER=groq
REFINER_MODEL=openai/gpt-oss-120b
REFINER_TEMPERATURE=0
REFINER_STRUCTURED_MODE=json_schema
REFINER_REQUEST_TIMEOUT_SECONDS=90
REFINER_TRANSPORT_RETRIES=1
REFINER_MAX_BACKOFF_SECONDS=60
REFINER_SCHEMA_REPAIR_RETRIES=1
REFINER_TOP_K=3

# Phase VI: distinct LLM #2 extraction role, using the same Groq credential.
INTELLIGENCE_PROVIDER=groq
INTELLIGENCE_MODEL=openai/gpt-oss-120b
INTELLIGENCE_TEMPERATURE=0
INTELLIGENCE_TIMEOUT_SECONDS=90
INTELLIGENCE_MAX_COMPLETION_TOKENS=8192
INTELLIGENCE_TRANSPORT_RETRIES=1
INTELLIGENCE_MAX_BACKOFF_SECONDS=60
INTELLIGENCE_SCHEMA_REPAIR_RETRIES=1
INTELLIGENCE_MAX_CHUNK_CHARS=18000
INTELLIGENCE_OVERLAP_UTTERANCES=2
INTELLIGENCE_MAX_CHUNKS=32
INTELLIGENCE_MAX_CONSOLIDATION_CHARS=90000
INTELLIGENCE_MAX_ITEMS_PER_SECTION=128

# Phase VII local application. Keep a single process and one active pipeline job.
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_MAX_UPLOAD_BYTES=4294967296
WEB_JOB_ROOT=jobs/web
WEB_MAX_ACTIVE_JOBS=1
WEB_FRONTEND_DIST=frontend/dist

# Phase VIII: optional contextual re-ASR; disabled by default.
# Context retrieval works without enabling additional ASR calls.
CONTEXT_ASR_ENABLED=false
CONTEXT_ASR_USE_GLOBAL_GLOSSARY=false
CONTEXT_ASR_MAX_WINDOWS=6
CONTEXT_ASR_MAX_WINDOW_SECONDS=15
CONTEXT_ASR_PADDING_SECONDS=2
CONTEXT_ASR_MERGE_GAP_SECONDS=0.5
CONTEXT_ASR_TOP_K_TERMS=6
CONTEXT_ASR_MIN_PRIORITY=0.70
CONTEXT_ASR_MAX_TOTAL_AUDIO_SECONDS=60
CONTEXT_ASR_TOTAL_TIMEOUT_SECONDS=180
# Phase IX optional shadow diarization (never changes primary speakers/transcript).
SPEAKER_RELIABILITY_ENABLED=false
SECONDARY_DIARIZER_BACKEND=sortformer
SECONDARY_DIARIZER_DEVICE=cuda
SECONDARY_DIARIZER_PYTHON=.venv-secondary/Scripts/python.exe
SECONDARY_DIARIZER_MODEL_PATH=.models/sortformer/diar_sortformer_4spk-v1.nemo
SPEAKER_RELIABILITY_RELIABLE_THRESHOLD=0.90
SPEAKER_RELIABILITY_MIXED_THRESHOLD=0.65
SPEAKER_RELIABILITY_MAX_SPEAKERS=4
SPEAKER_RELIABILITY_TIMEOUT_SECONDS=600
# Conservative whole-recording GPU guard for the non-streaming baseline. Explicitly raise after measuring.
SECONDARY_DIARIZER_MAX_DURATION_SECONDS=120

# Phase X: experimental local typed semantic decisions, disabled by default.
# Scores are uncalibrated; MeetingRecord is never changed automatically.
SEMANTIC_ENABLED=false
SEMANTIC_PROVIDER=julia
SEMANTIC_MODEL=SupersonicLabs/Julia-1
SEMANTIC_MODEL_CACHE=.models/semantic/julia-1
SEMANTIC_LOCAL_PYTHON=.venv-semantic/Scripts/python.exe
SEMANTIC_LOCAL_DEVICE=cuda
SEMANTIC_LOCAL_MAX_LENGTH=4096
SEMANTIC_LOCAL_HEAD_LENGTH=768
SEMANTIC_ACCEPTANCE_PROBABILITY=0.85
SEMANTIC_REVIEW_PROBABILITY=0.60
SEMANTIC_MAX_EVENT_CALLS=80
SEMANTIC_MAX_RELATION_CALLS=100
SEMANTIC_MAX_VERIFICATION_CALLS=50
SEMANTIC_MAX_COVERAGE_CALLS=70
SEMANTIC_MAX_TOTAL_CALLS=250
SEMANTIC_REQUEST_TIMEOUT_SECONDS=60
SEMANTIC_TOTAL_TIMEOUT_SECONDS=180
# Alternative gliner uses fastino/GLiNER2.5-Decide, .models/semantic/gliner-decide,
# and .venv-decision/Scripts/python.exe. Override all four provider/model/cache/python values together.
# Optional legacy TypeSafe backend: provider=typesafe, model=jev-1.13.0.
TYPESAFE_API_KEY=
